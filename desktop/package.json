{
  "name": "kiirabi-desktop",
  "productName": "Einsatz 112",
  "version": "1.0.0",
  "description": "Einsatz 112 – medizinisches Lernspiel",
  "author": "Einsatz 112",
  "repository": "github:tobiaslangde-eng/retung",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prepare-app": "cd .. && node -e \"require('fs').mkdirSync('desktop/app',{recursive:true})\" && npx expo export --platform web --output-dir dist && node scripts/build-single-html.mjs dist desktop/app/index.html",
    "start": "electron .",
    "dist:win": "electron-builder --win portable nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --x64 --arm64 --publish never",
    "dist:linux": "electron-builder --linux AppImage --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.tobiaslangde.einsatz112",
    "productName": "Einsatz 112",
    "copyright": "Einsatz 112 – Lernspiel",
    "files": [
      "main.js",
      "app/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "artifactName": "Einsatz112-${os}-${arch}.${ext}",
    "portable": {
      "artifactName": "Einsatz112-Windows.exe"
    },
    "mac": {
      "category": "public.app-category.education",
      "identity": "-",
      "artifactName": "Einsatz112-Mac-${arch}.${ext}"
    },
    "linux": {
      "category": "Education",
      "artifactName": "Einsatz112-Linux.AppImage"
    },
    "publish": null,
    "nsis": {
      "artifactName": "Einsatz112-Windows-Setup.exe",
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
